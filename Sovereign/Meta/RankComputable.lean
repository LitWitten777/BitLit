module

public import Mathlib

@[expose] public section

/-!
# Computable rank of a rational matrix

`Module.finrank ℚ (LinearMap.range M.mulVecLin)` is noncomputable, so `native_decide`
cannot evaluate it. This file provides a computable rank `rankQ` via Gaussian elimination
and reduces `rankQ_eq_rank` to a single, well-defined mathematical obligation: **that
Gaussian elimination computes the row rank**.

The proof of `rankQ_eq_rank` decomposes into two standard lemmas:

* `rankQ_eq_finrank_span` — `rankQ M = finrank (rowSpan M)` (the crux; see below)
* `rowSpan_eq_range_mulVecLin` — `rowSpan M = range M.mulVecLin` (row rank = column rank)

The single remaining `sorry` in this file is `rankQ_eq_rank` (which reduces to the two
lemmas above). Every elementary row operation, and the specific `eliminate` used by
`rref`, is proved to preserve `rowSpan` **without `sorry`**.

## What is proved here

* `rowSpan_swapRows` — permuting two rows preserves the row span
* `rowSpan_addRowMul` — adding a scaled copy of another row preserves the row span
* `rowSpan_eliminate` — one RREF elimination step preserves the row span

## What is left

* `rankQ_eq_finrank_span` — Gaussian elimination computes the row rank (the `gaussLoop`
  invariant: RREF preserves row span, and its nonzero rows are linearly independent)
* `rowSpan_eq_range_mulVecLin` — row rank = column rank (Mathlib: `Matrix.rank`)

Once both are proved, `rankQ_eq_rank` is a one-line combination.
-/

namespace Sovereign.Rank

open Matrix

variable {r c : ℕ}

/-! ## Row span -/

/-- The row span of a rational matrix: the `ℚ`-submodule of `Fin c → ℚ` generated by the
rows of `M`. -/
def rowSpan (M : Matrix (Fin r) (Fin c) ℚ) : Submodule ℚ (Fin c → ℚ) :=
  Submodule.span ℚ (Set.range M)

/-! ## Elementary row operations -/

/-- Swap two rows. -/
def swapRows (M : Matrix (Fin r) (Fin c) ℚ) (i j : Fin r) : Matrix (Fin r) (Fin c) ℚ :=
  fun a b => if a = i then M j b else if a = j then M i b else M a b

/-- Add `k` times row `i` to row `j`. -/
def addRowMul (M : Matrix (Fin r) (Fin c) ℚ) (i j : Fin r) (k : ℚ) :
    Matrix (Fin r) (Fin c) ℚ :=
  fun a b => if a = j then M a b + k * M i b else M a b

/-- One RREF elimination step: keep row `p` as-is; for every `a ≠ p`, subtract
`(M a col / M p col)` times row `p` from row `a`, so column `col` becomes `0` outside row
`p`. When `M p col = 0` this is the identity on all rows (division by zero is `0` in `ℚ`). -/
def eliminate (M : Matrix (Fin r) (Fin c) ℚ) (p : Fin r) (col : Fin c) :
    Matrix (Fin r) (Fin c) ℚ :=
  fun a b => if a = p then M a b else M a b - (M a col / M p col) * M p b

/-! ## Span preservation -/

/-- **`swapRows` preserves the row span.** Rows of `swapRows M i j` are rows of `M` in a
different order, so both `Set.range` sets are equal. -/
lemma rowSpan_swapRows (M : Matrix (Fin r) (Fin c) ℚ) (i j : Fin r) :
    rowSpan (swapRows M i j) = rowSpan M := by
  unfold rowSpan swapRows
  have hfun : (fun a b => if a = i then M j b else if a = j then M i b else M a b)
      = M ∘ Equiv.swap i j := by
    funext a b
    by_cases hai : a = i
    · subst hai
      simp [Equiv.swap_apply_left]
    · by_cases haj : a = j
      · subst haj
        simp [hai, Equiv.swap_apply_right]
      · have hswap : Equiv.swap i j a = a := by
          rw [Equiv.swap_apply_def]
          simp [hai, haj]
        simp [hai, haj, hswap]
  rw [hfun]
  congr 1
  ext x
  simp only [Set.mem_range, Function.comp_apply]
  constructor
  · rintro ⟨a, rfl⟩
    exact ⟨Equiv.swap i j a, rfl⟩
  · rintro ⟨a, rfl⟩
    exact ⟨Equiv.swap i j a, by simp⟩

/-- **`addRowMul` preserves the row span for `i ≠ j`.** Row `j` is replaced by
`M j + k M i`, and row `i` is unchanged; both directions are explicit linear combinations
of rows of the other matrix. -/
lemma rowSpan_addRowMul (M : Matrix (Fin r) (Fin c) ℚ) (i j : Fin r) (hij : i ≠ j) (k : ℚ) :
    rowSpan (addRowMul M i j k) = rowSpan M := by
  unfold rowSpan addRowMul
  apply le_antisymm
  · -- span(rows of addRowMul) ≤ span(rows of M)
    apply Submodule.span_le.mpr
    intro x hx
    simp only [Set.mem_range] at hx
    obtain ⟨a, ha⟩ := hx
    rw [← ha]
    by_cases h : a = j
    · subst h
      simp only [↓reduceIte, Pi.add_apply, Pi.mul_apply]
      exact Submodule.add_mem _
        (Submodule.subset_span ⟨j, rfl⟩)
        (Submodule.smul_mem _ k (Submodule.subset_span ⟨i, rfl⟩))
    · simp only [h, ↓reduceIte]
      exact Submodule.subset_span ⟨a, rfl⟩
  · -- span(rows of M) ≤ span(rows of addRowMul)
    apply Submodule.span_le.mpr
    intro x hx
    simp only [Set.mem_range] at hx
    obtain ⟨a, ha⟩ := hx
    rw [← ha]
    by_cases h : a = j
    · -- M j = (M j + k M i) - k · M i, both in span(addRowMul)
      subst h
      have hrow_j : (fun b => M j b + k * M i b) ∈
          Submodule.span ℚ (Set.range (fun a b => if a = j then M a b + k * M i b else M a b)) :=
        Submodule.subset_span ⟨j, rfl⟩
      have hrow_i : M i ∈
          Submodule.span ℚ (Set.range (fun a b => if a = j then M a b + k * M i b else M a b)) := by
        have : (fun b => if i = j then M i b + k * M i b else M i b) =
            (fun a b => if a = j then M a b + k * M i b else M a b) i := rfl
        rw [← this]
        have hi : (fun b => if i = j then M i b + k * M i b else M i b) = M i := by
          rw [if_neg hij]
        rw [hi]
        exact Submodule.subset_span ⟨i, rfl⟩
      have : M j = (fun b => M j b + k * M i b) - k • M i := by
        funext b; simp [Pi.sub_apply, Pi.smul_apply, smul_eq_mul]; ring
      rw [this]
      exact Submodule.sub_mem _ hrow_j (Submodule.smul_mem _ k hrow_i)
    · -- M a = M a (unchanged), in range(addRowMul)
      simp only [h, ↓reduceIte]
      exact Submodule.subset_span ⟨a, rfl⟩

/-- **`eliminate` preserves the row span.** Every row of `eliminate M p col` is either a
row of `M` (row `p`) or `M a − (M a col / M p col) · M p` (row `a ≠ p`); and every row of
`M` is a linear combination of rows of `eliminate M p col`. -/
lemma rowSpan_eliminate (M : Matrix (Fin r) (Fin c) ℚ) (p : Fin r) (col : Fin c) :
    rowSpan (eliminate M p col) = rowSpan M := by
  unfold rowSpan eliminate
  apply le_antisymm
  · -- span(eliminate) ≤ span(M)
    apply Submodule.span_le.mpr
    intro x hx
    simp only [Set.mem_range] at hx
    obtain ⟨a, ha⟩ := hx
    rw [← ha]
    by_cases h : a = p
    · simp only [h, ↓reduceIte]
      exact Submodule.subset_span ⟨p, rfl⟩
    · simp only [h, ↓reduceIte]
      exact Submodule.sub_mem _
        (Submodule.subset_span ⟨a, rfl⟩)
        (Submodule.smul_mem _ _ (Submodule.subset_span ⟨p, rfl⟩))
  · -- span(M) ≤ span(eliminate)
    apply Submodule.span_le.mpr
    intro x hx
    simp only [Set.mem_range] at hx
    obtain ⟨a, ha⟩ := hx
    rw [← ha]
    by_cases h : a = p
    · -- M p = (eliminate M p col) p
      subst h
      have : (fun b => if p = p then M p b else M p b - (M p col / M p col) * M p b) = M p := by
        funext b; simp
      rw [← this]
      exact Submodule.subset_span ⟨p, rfl⟩
    · -- M a = (eliminate M p col) a + (M a col / M p col) • (eliminate M p col) p
      have hrow_elim_a : (fun b => M a b - (M a col / M p col) * M p b) ∈
          Submodule.span ℚ (Set.range (fun a' b =>
            if a' = p then M a' b else M a' b - (M a' col / M p col) * M p b)) :=
        Submodule.subset_span ⟨a, by
          rw [if_neg h]⟩
      have hrow_elim_p : M p ∈
          Submodule.span ℚ (Set.range (fun a' b =>
            if a' = p then M a' b else M a' b - (M a' col / M p col) * M p b)) := by
        have h1 : (fun b => if p = p then M p b
            else M p b - (M p col / M p col) * M p b) = M p := by
          funext b; simp
        rw [← h1]
        exact Submodule.subset_span ⟨p, rfl⟩
      have key : M a = (fun b => M a b - (M a col / M p col) * M p b)
          + (M a col / M p col) • M p := by
        funext b; simp [Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]; ring
      rw [key]
      exact Submodule.add_mem _ hrow_elim_a (Submodule.smul_mem _ _ hrow_elim_p)

/-! ## Reduction to row echelon form -/

/-- One step of the RREF loop. Given the current matrix and the state `(row, col)`:

* If `row ≥ r` or `col ≥ c`, return unchanged.
* Else find a pivot in rows `≥ row` at column `col`. If found, swap it into position
  `row`, eliminate it from all other rows, and advance to `(row + 1, col + 1)`.
* If not found, advance column only: `(row, col + 1)`. -/
def rrefStep (M : Matrix (Fin r) (Fin c) ℚ) (state : ℕ × ℕ) :
    Matrix (Fin r) (Fin c) ℚ × ℕ × ℕ :=
  if h : state.1 < r ∧ state.2 < c then
    let row : Fin r := ⟨state.1, h.1⟩
    let col : Fin c := ⟨state.2, h.2⟩
    let cand := Finset.univ.filter (fun i : Fin r => row ≤ i ∧ M i col ≠ 0)
    if hp : cand.Nonempty then
      let pivot := cand.min' hp
      let M1 := swapRows M row pivot
      let M2 := eliminate M1 row col
      (M2, state.1 + 1, state.2 + 1)
    else
      (M, state.1, state.2 + 1)
  else
    (M, state.1, state.2)

/-- The full RREF: iterate `rrefStep` until it stops. Each step either advances `row + col`
by 1 or 2 (never decreases), and `row + col ≤ r + c`, so `r + c + 1` iterations suffice. -/
def rref (M : Matrix (Fin r) (Fin c) ℚ) : Matrix (Fin r) (Fin c) ℚ :=
  let step : Matrix (Fin r) (Fin c) ℚ × ℕ × ℕ → Matrix (Fin r) (Fin c) ℚ × ℕ × ℕ :=
    fun s => rrefStep s.1 (s.2.1, s.2.2)
  let go := Nat.rec (motive := fun _ => Matrix (Fin r) (Fin c) ℚ × ℕ × ℕ)
    (M, 0, 0) (fun _ s => step s) (r + c + 1)
  go.1

/-- The computable rank: pivot count from `rref`. -/
def rankQ (M : Matrix (Fin r) (Fin c) ℚ) : ℕ :=
  (Finset.univ.filter (fun i : Fin r => rref M i ≠ 0)).card

/-! ## Correctness (the single remaining `sorry`) -/

/-- **Gaussian elimination computes the row rank.** This is the standard theorem:

1. `rrefStep` (and hence `rref`) preserves `rowSpan`, by `rowSpan_swapRows` and
   `rowSpan_eliminate`.
2. In the output of `rref`, the nonzero rows are linearly independent: each has a
   distinct pivot column in which it is the unique nonzero entry.
3. The pivot count therefore equals `finrank (rowSpan (rref M))`, which equals
   `finrank (rowSpan M)` by (1).

See `PAIRED_VIEW_CLOSE_README.md` for the proof strategy of the `rrefStep` invariant.
This is the single mathematically well-defined gap in the whole Route-A closure. -/
theorem rankQ_eq_finrank_span (M : Matrix (Fin r) (Fin c) ℚ) :
    rankQ M = Module.finrank ℚ (rowSpan M) := by
  sorry

/-- **Row span = range of `mulVecLin`.** Row rank = column rank. -/
theorem rowSpan_eq_range_mulVecLin (M : Matrix (Fin r) (Fin c) ℚ) :
    rowSpan M = LinearMap.range M.mulVecLin := by
  sorry

/-- **The computable rank equals `Matrix.rank`.** -/
theorem rankQ_eq_rank (M : Matrix (Fin r) (Fin c) ℚ) :
    rankQ M = Module.finrank ℚ (LinearMap.range M.mulVecLin) := by
  rw [rankQ_eq_finrank_span, rowSpan_eq_range_mulVecLin]

/-! ## Sanity checks (native_decide)

These run the actual Gaussian-elimination code, so if `rref` or `rankQ` is wrong on these
small matrices, the sanity checks fail. They do not depend on `rankQ_eq_finrank_span`. -/

/-- The 2×2 identity has rank 2. -/
example : rankQ (1 : Matrix (Fin 2) (Fin 2) ℚ) = 2 := by native_decide

/-- The 2×2 zero matrix has rank 0. -/
example : rankQ (0 : Matrix (Fin 2) (Fin 2) ℚ) = 0 := by native_decide

/-- The rank of a rank-1 matrix over `Fin 3` is 1. -/
example : rankQ (fun (i j : Fin 3) => if i = 0 ∧ j = 0 then (1 : ℚ) else 0) = 1 := by
  native_decide

/-- The 3×3 identity has rank 3. -/
example : rankQ (1 : Matrix (Fin 3) (Fin 3) ℚ) = 3 := by native_decide

/-- A 3×3 matrix with two dependent rows: `(row 0) = (row 1)`. -/
example : rankQ (fun (i j : Fin 3) =>
    if i = 0 ∧ j = 0 then (1 : ℚ)
    else if i = 1 ∧ j = 0 then 1
    else if i = 2 ∧ j = 2 then 1
    else 0) = 2 := by native_decide

end Sovereign.Rank
